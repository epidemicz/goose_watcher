// The watcher package's native part: the C layer over the OS's own
// directory notifications, a CMake project (CMakeLists.txt beside this
// file). Thread-safe by construction (slot table + per-thread error, no
// main_thread_only).

// Examples are their own root files: they are not part of the package's
// own Goose, and the compiler must not try to compile them into it.
cmake_target = "goose_watcher";
exclude = ["examples"];
